    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.6",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=22.9"
  }
