# Postgres connection string (your AWS RDS database, or any Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/castliner?schema=public"
# Long random string used to sign logins. Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-string"
